@page "/"
@inject ICourseService CourseService
@inject IInstructorService InstructorService
@inject IStudentService StudentService

<PageTitle>Home - Online Course Management</PageTitle>

<div class="page-header">
    <div>
        <h1>Welcome to the Online Course Management System</h1>
        <p class="text-muted mb-0">A comprehensive platform for managing courses, instructors, students, and learning materials.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="fs-3 fw-bold text-primary">@courseCount</div>
            <div class="text-muted">Courses</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="fs-3 fw-bold text-primary">@instructorCount</div>
            <div class="text-muted">Instructors</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="fs-3 fw-bold text-primary">@studentCount</div>
            <div class="text-muted">Students</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center p-3">
            <div class="fs-3 fw-bold text-primary">@enrollmentCount</div>
            <div class="text-muted">Enrollments</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">📚 Courses</h5>
                <p class="card-text">Browse, add, edit and search courses offered in the system.</p>
                <a href="/courses" class="btn btn-primary">View Courses</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">👨‍🏫 Instructors</h5>
                <p class="card-text">Manage the instructors who teach on the platform.</p>
                <a href="/instructors" class="btn btn-primary">View Instructors</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">📊 My Dashboard</h5>
                <p class="card-text">Track enrolled courses, lessons, assignments and results.</p>
                <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
            </div>
        </div>
    </div>
</div>

