@code {
    private int courseCount;
    private int instructorCount;
    private int studentCount;
    private int enrollmentCount;

    protected override async Task OnInitializedAsync()
    {
        var courses = await CourseService.GetAllCoursesAsync();
        courseCount = courses.Count;
        instructorCount = (await InstructorService.GetAllInstructorsAsync()).Count;
        studentCount = (await StudentService.GetAllStudentsAsync()).Count;
        enrollmentCount = courses.Sum(c => c.EnrolledStudents);
    }
}
