@page "/"

<PageTitle>Home - Online Course Management</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1>Welcome to Online Course Management System</h1>
            <p class="lead">A comprehensive platform for managing courses, instructors, students, and learning materials.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Courses</h5>
                    <p class="card-text">Browse and manage courses offered in the system.</p>
                    <a href="/courses" class="btn btn-primary">View Courses</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Instructors</h5>
                    <p class="card-text">Find information about available instructors.</p>
                    <a href="/instructors" class="btn btn-primary">View Instructors</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">My Dashboard</h5>
                    <p class="card-text">Access your enrolled courses and progress tracking.</p>
                    <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <h3>About This System</h3>
            <p>
                The Online Course Management System is built with:
            </p>
            <ul>
                <li><strong>Blazor WebAssembly</strong> - Modern interactive UI</li>
                <li><strong>Entity Framework Core</strong> - Data access layer</li>
                <li><strong>.NET 8</strong> - Robust backend framework</li>
            </ul>
        </div>
    </div>
</div>

