@page "/assignments"
@inject ICourseService CourseService
@inject IAssignmentService AssignmentService
@inject IJSRuntime JS

<PageTitle>Assignments</PageTitle>

<div class="page-header">
    <div>
        <h1>Assignments</h1>
        <p class="text-muted mb-0">Create and manage assignments for a course.</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <label class="form-label">Select Course</label>
        <select class="form-select" @bind="selectedCourseId" @bind:after="LoadAssignments">
            <option value="0">-- Select a course --</option>
            @foreach (var course in courses)
            {
                <option value="@course.Id">@course.Title</option>
            }
        </select>
    </div>
</div>

@if (selectedCourseId > 0)
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Assignment</button>
    </div>

    @if (showForm)
    {
        <div class="form-card">
            <h5>@(editingId == null ? "Add Assignment" : "Edit Assignment")</h5>
            <EditForm Model="formModel" OnValidSubmit="SaveAssignment">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title</label>
                        <InputText class="form-control" @bind-Value="formModel.Title" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="formModel.AssignmentType">
                            <option value="Quiz">Quiz</option>
                            <option value="Project">Project</option>
                            <option value="Essay">Essay</option>
                            <option value="Practical">Practical</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Max Marks</label>
                        <InputNumber class="form-control" @bind-Value="formModel.MaxMarks" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="formModel.Description" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Due Date</label>
                        <InputDate class="form-control" @bind-Value="formModel.DueDate" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="publishAssignment" @bind-Value="formModel.IsPublished" />
                            <label class="form-check-label" for="publishAssignment">Published</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    @if (assignments.Count == 0)
    {
        <div class="empty-state"><p>No assignments yet for this course.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Due Date</th>
                        <th>Max Marks</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in assignments)
                    {
                        <tr>
                            <td class="fw-semibold">@assignment.Title</td>
                            <td>@assignment.AssignmentType</td>
                            <td>@assignment.DueDate.ToString("MMM dd, yyyy")</td>
                            <td>@assignment.MaxMarks</td>
                            <td>
                                @if (assignment.IsPublished)
                                {
                                    <span class="badge badge-status-active">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditAssignment(assignment)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAssignment(assignment.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="empty-state"><p>Select a course above to view and manage its assignments.</p></div>
}

@code {
    private List<CourseDTO> courses = new();
    private List<Assignment> assignments = new();
    private Assignment formModel = new();
    private int selectedCourseId;
    private bool showForm;
    private int? editingId;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetAllCoursesAsync();
    }

    private async Task LoadAssignments()
    {
        assignments = selectedCourseId > 0
            ? await AssignmentService.GetAssignmentsByCourseAsync(selectedCourseId)
            : new List<Assignment>();
        showForm = false;
    }

    private void ShowAddForm()
    {
        formModel = new Assignment { CourseId = selectedCourseId, AssignmentType = "Quiz", DueDate = DateTime.Today.AddDays(7), MaxMarks = 100 };
        editingId = null;
        showForm = true;
    }

    private void EditAssignment(Assignment assignment)
    {
        formModel = new Assignment
        {
            Id = assignment.Id,
            CourseId = assignment.CourseId,
            Title = assignment.Title,
            Description = assignment.Description,
            DueDate = assignment.DueDate,
            MaxMarks = assignment.MaxMarks,
            AssignmentType = assignment.AssignmentType,
            IsPublished = assignment.IsPublished
        };
        editingId = assignment.Id;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task SaveAssignment()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            return;
        }

        formModel.CourseId = selectedCourseId;
        if (editingId == null)
        {
            await AssignmentService.AddAssignmentAsync(formModel);
        }
        else
        {
            await AssignmentService.UpdateAssignmentAsync(formModel);
        }

        showForm = false;
        await LoadAssignments();
    }

    private async Task DeleteAssignment(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this assignment? This will also remove any recorded results for it.");
        if (!confirmed)
        {
            return;
        }
        await AssignmentService.DeleteAssignmentAsync(id);
        await LoadAssignments();
    }
}
