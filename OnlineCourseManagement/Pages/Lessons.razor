@page "/lessons"
@inject ICourseService CourseService
@inject ILessonService LessonService
@inject IJSRuntime JS

<PageTitle>Lessons</PageTitle>

<div class="page-header">
    <div>
        <h1>Lessons</h1>
        <p class="text-muted mb-0">Add and manage lessons for a course.</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <label class="form-label">Select Course</label>
        <select class="form-select" @bind="selectedCourseId" @bind:after="LoadLessons">
            <option value="0">-- Select a course --</option>
            @foreach (var course in courses)
            {
                <option value="@course.Id">@course.Title</option>
            }
        </select>
    </div>
</div>

@if (selectedCourseId > 0)
{
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Lesson</button>
    </div>

    @if (showForm)
    {
        <div class="form-card">
            <h5>@(editingId == null ? "Add Lesson" : "Edit Lesson")</h5>
            <EditForm Model="formModel" OnValidSubmit="SaveLesson">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">Title</label>
                        <InputText class="form-control" @bind-Value="formModel.Title" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Duration (minutes)</label>
                        <InputNumber class="form-control" @bind-Value="formModel.DurationMinutes" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="formModel.Description" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Content</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="formModel.Content" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Video URL (optional)</label>
                        <InputText class="form-control" @bind-Value="formModel.VideoUrl" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" id="publishLesson" @bind-Value="formModel.IsPublished" />
                            <label class="form-check-label" for="publishLesson">Published</label>
                        </div>
                    </div>
                </div>
                <div class="mt-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
                </div>
            </EditForm>
        </div>
    }

    @if (lessons.Count == 0)
    {
        <div class="empty-state"><p>No lessons yet for this course.</p></div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lesson in lessons)
                    {
                        <tr>
                            <td>@lesson.OrderNumber</td>
                            <td>
                                <div class="fw-semibold">@lesson.Title</div>
                                <div class="text-muted small">@lesson.Description</div>
                            </td>
                            <td>@lesson.DurationMinutes min</td>
                            <td>
                                @if (lesson.IsPublished)
                                {
                                    <span class="badge badge-status-active">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditLesson(lesson)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteLesson(lesson.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <div class="empty-state"><p>Select a course above to view and manage its lessons.</p></div>
}

@code {
    private List<CourseDTO> courses = new();
    private List<Lesson> lessons = new();
    private Lesson formModel = new();
    private int selectedCourseId;
    private bool showForm;
    private int? editingId;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetAllCoursesAsync();
    }

    private async Task LoadLessons()
    {
        lessons = selectedCourseId > 0
            ? await LessonService.GetLessonsByCourseAsync(selectedCourseId)
            : new List<Lesson>();
        showForm = false;
    }

    private void ShowAddForm()
    {
        formModel = new Lesson { CourseId = selectedCourseId };
        editingId = null;
        showForm = true;
    }

    private void EditLesson(Lesson lesson)
    {
        formModel = new Lesson
        {
            Id = lesson.Id,
            CourseId = lesson.CourseId,
            Title = lesson.Title,
            Description = lesson.Description,
            Content = lesson.Content,
            OrderNumber = lesson.OrderNumber,
            VideoUrl = lesson.VideoUrl,
            DurationMinutes = lesson.DurationMinutes,
            IsPublished = lesson.IsPublished
        };
        editingId = lesson.Id;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
    }

    private async Task SaveLesson()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title))
        {
            return;
        }

        formModel.CourseId = selectedCourseId;
        if (editingId == null)
        {
            await LessonService.AddLessonAsync(formModel);
        }
        else
        {
            await LessonService.UpdateLessonAsync(formModel);
        }

        showForm = false;
        await LoadLessons();
    }

    private async Task DeleteLesson(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this lesson?");
        if (!confirmed)
        {
            return;
        }
        await LessonService.DeleteLessonAsync(id);
        await LoadLessons();
    }
}
