@page "/courses"
@inject ICourseService CourseService
@inject IInstructorService InstructorService
@inject IJSRuntime JS

<PageTitle>Courses</PageTitle>

<div class="page-header">
    <div>
        <h1>Courses</h1>
        <p class="text-muted mb-0">Manage the courses offered in the system.</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Course</button>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <input class="form-control" placeholder="Search by title, code, level or instructor..." value="@searchTerm" @oninput="OnSearchInput" />
    </div>
</div>

@if (showForm)
{
    <div class="form-card">
        <h5>@(editingId == null ? "Add New Course" : "Edit Course")</h5>
        <EditForm Model="formModel" OnValidSubmit="SaveCourse">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Title</label>
                    <InputText class="form-control" @bind-Value="formModel.Title" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Code</label>
                    <InputText class="form-control" @bind-Value="formModel.Code" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Level</label>
                    <InputSelect class="form-select" @bind-Value="formModel.Level">
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </InputSelect>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="formModel.Description" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Instructor</label>
                    <InputSelect class="form-select" @bind-Value="formModel.InstructorId">
                        <option value="0">-- Select Instructor --</option>
                        @foreach (var instructor in instructors)
                        {
                            <option value="@instructor.Id">@instructor.FirstName @instructor.LastName</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Duration (wks)</label>
                    <InputNumber class="form-control" @bind-Value="formModel.Duration" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Max Students</label>
                    <InputNumber class="form-control" @bind-Value="formModel.MaxStudents" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Credits</label>
                    <InputNumber class="form-control" @bind-Value="formModel.Credits" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Start Date</label>
                    <InputDate class="form-control" @bind-Value="formModel.StartDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">End Date</label>
                    <InputDate class="form-control" @bind-Value="formModel.EndDate" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
            }
        </EditForm>
    </div>
}

@if (courses == null)
{
    <p><em>Loading...</em></p>
}
else if (courses.Count == 0)
{
    <div class="empty-state"><p>No courses found. Try adding one!</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Instructor</th>
                    <th>Level</th>
                    <th>Duration</th>
                    <th>Enrolled</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in courses)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@course.Title</div>
                            <div class="text-muted small">@course.Code</div>
                        </td>
                        <td>@course.InstructorName</td>
                        <td><span class="badge @LevelBadgeClass(course.Level)">@course.Level</span></td>
                        <td>@course.Duration wks</td>
                        <td>@course.EnrolledStudents / @course.MaxStudents</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCourse(course)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCourse(course.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<CourseDTO> courses = new();
    private List<InstructorDTO> instructors = new();
    private CourseDTO formModel = new();
    private bool showForm;
    private int? editingId;
    private string searchTerm = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        instructors = await InstructorService.GetAllInstructorsAsync();
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        courses = string.IsNullOrWhiteSpace(searchTerm)
            ? await CourseService.GetAllCoursesAsync()
            : await CourseService.SearchCoursesAsync(searchTerm);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        await LoadCourses();
    }

    private void ShowAddForm()
    {
        formModel = new CourseDTO { Level = "Beginner", StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(2) };
        editingId = null;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void EditCourse(CourseDTO course)
    {
        formModel = new CourseDTO
        {
            Id = course.Id,
            Title = course.Title,
            Description = course.Description,
            Code = course.Code,
            InstructorId = course.InstructorId,
            Duration = course.Duration,
            MaxStudents = course.MaxStudents,
            Credits = course.Credits,
            Level = course.Level,
            StartDate = course.StartDate,
            EndDate = course.EndDate
        };
        editingId = course.Id;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = string.Empty;
    }

    private async Task SaveCourse()
    {
        if (string.IsNullOrWhiteSpace(formModel.Title) || string.IsNullOrWhiteSpace(formModel.Code))
        {
            errorMessage = "Title and Code are required.";
            return;
        }
        if (formModel.InstructorId <= 0)
        {
            errorMessage = "Please select an instructor.";
            return;
        }

        if (editingId == null)
        {
            await CourseService.AddCourseAsync(formModel);
        }
        else
        {
            formModel.Id = editingId.Value;
            await CourseService.UpdateCourseAsync(formModel);
        }

        showForm = false;
        await LoadCourses();
    }

    private async Task DeleteCourse(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this course? This will also remove its enrollments, lessons and assignments.");
        if (!confirmed)
        {
            return;
        }
        await CourseService.DeleteCourseAsync(id);
        await LoadCourses();
    }

    private static string LevelBadgeClass(string level) => level switch
    {
        "Beginner" => "badge-level-beginner",
        "Intermediate" => "badge-level-intermediate",
        "Advanced" => "badge-level-advanced",
        _ => "bg-secondary"
    };
}
