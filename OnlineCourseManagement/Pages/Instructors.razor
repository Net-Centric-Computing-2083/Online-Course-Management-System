@page "/instructors"
@inject IInstructorService InstructorService
@inject ICourseService CourseService
@inject IJSRuntime JS

<PageTitle>Instructors</PageTitle>

<div class="page-header">
    <div>
        <h1>Instructors</h1>
        <p class="text-muted mb-0">Manage the instructors who teach on the platform.</p>
    </div>
    <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Instructor</button>
</div>

@if (showForm)
{
    <div class="form-card">
        <h5>@(editingId == null ? "Add New Instructor" : "Edit Instructor")</h5>
        <EditForm Model="formModel" OnValidSubmit="SaveInstructor">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">First Name</label>
                    <InputText class="form-control" @bind-Value="formModel.FirstName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Last Name</label>
                    <InputText class="form-control" @bind-Value="formModel.LastName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" type="email" @bind-Value="formModel.Email" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Phone Number</label>
                    <InputText class="form-control" @bind-Value="formModel.PhoneNumber" />
                </div>
                <div class="col-md-8">
                    <label class="form-label">Specialization</label>
                    <InputText class="form-control" @bind-Value="formModel.Specialization" />
                </div>
                <div class="col-12">
                    <label class="form-label">Bio</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="formModel.Bio" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3 mb-0">@errorMessage</div>
            }
        </EditForm>
    </div>
}

@if (instructors == null)
{
    <p><em>Loading...</em></p>
}
else if (instructors.Count == 0)
{
    <div class="empty-state"><p>No instructors yet. Add the first one!</p></div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Specialization</th>
                    <th>Courses</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instructor in instructors)
                {
                    <tr>
                        <td class="fw-semibold">@instructor.FirstName @instructor.LastName</td>
                        <td>@instructor.Email</td>
                        <td>@instructor.Specialization</td>
                        <td>@CourseCountFor(instructor.Id)</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditInstructor(instructor)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteInstructor(instructor.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<InstructorDTO> instructors = new();
    private List<CourseDTO> courses = new();
    private InstructorDTO formModel = new();
    private bool showForm;
    private int? editingId;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        instructors = await InstructorService.GetAllInstructorsAsync();
        courses = await CourseService.GetAllCoursesAsync();
    }

    private int CourseCountFor(int instructorId) => courses.Count(c => c.InstructorId == instructorId);

    private void ShowAddForm()
    {
        formModel = new InstructorDTO();
        editingId = null;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void EditInstructor(InstructorDTO instructor)
    {
        formModel = new InstructorDTO
        {
            Id = instructor.Id,
            FirstName = instructor.FirstName,
            LastName = instructor.LastName,
            Email = instructor.Email,
            PhoneNumber = instructor.PhoneNumber,
            Specialization = instructor.Specialization,
            Bio = instructor.Bio
        };
        editingId = instructor.Id;
        errorMessage = string.Empty;
        showForm = true;
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = string.Empty;
    }

    private async Task SaveInstructor()
    {
        if (string.IsNullOrWhiteSpace(formModel.FirstName) || string.IsNullOrWhiteSpace(formModel.LastName) || string.IsNullOrWhiteSpace(formModel.Email))
        {
            errorMessage = "First name, last name and email are required.";
            return;
        }

        if (editingId == null)
        {
            var newId = await InstructorService.AddInstructorAsync(formModel);
            if (newId == 0)
            {
                errorMessage = "An instructor with this email already exists.";
                return;
            }
        }
        else
        {
            formModel.Id = editingId.Value;
            await InstructorService.UpdateInstructorAsync(formModel);
        }

        showForm = false;
        await LoadData();
    }

    private async Task DeleteInstructor(int id)
    {
        if (CourseCountFor(id) > 0)
        {
            await JS.InvokeVoidAsync("alert", "This instructor is still teaching one or more courses. Reassign or remove those courses first.");
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Delete this instructor?");
        if (!confirmed)
        {
            return;
        }
        await InstructorService.DeleteInstructorAsync(id);
        await LoadData();
    }
}
